# Runtime
PORT=8080
KTOR_ENV=development

# Authentication and authorization
JWT_SECRET=
JWT_AUDIENCE=
JWT_ISSUER=
GOOGLE_CLIENT_ID=
ADMIN_SNAPSHOT_TOKEN=

# Push notifications (plan §18)
ENABLE_PUSH_DISPATCHER=false
CRON_SECRET=
ADMIN_PUSH_TEST_TOKEN=
METRICS_SECRET=
# Firebase service-account JSON for each project (G15) — paste the whole downloaded JSON as one line.
FCM_SA_JSON_DEBUG=
FCM_SA_JSON_RELEASE=

# Local image storage (used only when STORAGE_PROVIDER=local)
# Use a path reachable by the process running the server.
LOCAL_STORAGE_BASE_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8080

# Cloudflare R2 image storage (used when STORAGE_PROVIDER=r2)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# PostgreSQL bootstrap credentials for Docker Compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Development database
DEV_USER=
DEV_PASSWORD=
DEV_DB=
DEV_DB_URL=jdbc:postgresql://localhost:5433/

# Test database
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB=
TEST_DB_URL=jdbc:postgresql://postgres:5432/

# Production database
PROD_USER=
PROD_PASSWORD=
PROD_DB=
PROD_DB_URL=jdbc:postgresql://postgres:5432/
